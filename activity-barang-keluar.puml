@startuml
skinparam ActivityBackgroundColor #FEFEFE
skinparam ActivityBorderColor #0066CC
skinparam NoteBackgroundColor #FFF9E6
skinparam NoteBorderColor #FFCC00
skinparam ArrowColor #0066CC

title Activity Diagram - Pencatatan Barang Keluar

|Admin|
start
:Membuka Halaman Barang Keluar;
:Klik Tombol "Tambah Barang Keluar";

|Sistem|
:Menampilkan Form Input Barang Keluar\n(Pilih Sparepart, Jumlah, Tanggal, Keterangan);

|Admin|
:Memilih Sparepart;
:Memasukkan Jumlah (> 0), Tanggal, & Keterangan;
:Klik Tombol "Simpan";

|Sistem|
if (Apakah Form Input Valid?) then (Tidak)
    :Menampilkan Pesan Validasi Error;
    detach
else (Ya)
    :Mengambil Stok Terakhir dari Database;
    if (Apakah Jumlah Keluar <= Stok Tersedia?) then (Tidak)
        :Menampilkan Pesan Error\n"Stok tidak mencukupi";
        detach
    else (Ya)
        :Menyimpan Data Transaksi ke Tabel 'barang_keluar';
        :Melakukan Kalkulasi Stok:\nStok Baru = Stok Lama - Jumlah Keluar;
        :Memperbarui Nilai 'stok' di Tabel 'spareparti';
        
        if (Apakah Stok Baru <= Stok Minimal?) then (Ya)
            :Menandai Sparepart sebagai 'Stok Kritis'\n(Visual Warning & Notifikasi Dashboard);
        else (Tidak)
        endif
        
        :Menampilkan Flash Message Sukses\n"Barang keluar berhasil dicatat";
        :Mengarahkan ke Halaman Daftar Barang Keluar;
        |Admin|
        :Melihat Catatan Transaksi Baru;
        stop
    endif
endif

@endum
